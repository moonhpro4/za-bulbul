 (op == \"+\") {\n        result = num1 + cur\n    } else if (op == \"-\") {\n        result = num1 - cur\n    } else if (op == \"x\") {\n        result = num1 * cur\n    } else if (op == \"/\") {\n        if (cur == 0) {\n            basic.showString(\"Error\")\n            resetAll()\n            return\n        }\n        result = num1 / cur\n    } else {\n        result = cur\n    }\n    basic.showNumber(result)\n    cur = result\n    op = \"\"\n    fresh = true\n}\n// Logo touch or shake = clear\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    resetAll()\n})\nlet result = 0\nlet fresh = false\nlet op = \"\"\nlet cur = 0\nlet num1 = 0\nresetAll()\n","README.md":"","pxt.json":"{\n    \"name\": \"Za Bulbul\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1791452218335}